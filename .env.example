# Port the server listens on by default.
PORT=65432

# SQLite database file name. Relative names are resolved under
# ~/.config/outpost (an absolute path is used as-is).
DB_FILE_NAME=outpost.db

# Secret used by Better Auth to sign sessions/cookies. Use a long random value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL (the cloudflared tunnel URL). This must be the externally
# reachable origin, otherwise OAuth discovery points clients at localhost.
BETTER_AUTH_URL=https://outpost.example.com

# Canonical MCP protected resource identifier (RFC 9728). Use the public URL
# of the MCP endpoint, including its path.
MCP_RESOURCE_URL=https://outpost.example.com/mcp

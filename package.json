{
  "name": "outpost",
  "module": "src/index.ts",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "format": "prettier --write .",
    "build": "bun build --production --compile --outfile=outpost --minify .",
    "build:target": "bun build --production --compile --minify --target=$TARGET --outfile=$OUTFILE ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.9.10"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
